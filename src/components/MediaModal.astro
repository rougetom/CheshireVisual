<dialog class="media-modal" id="mediaModal" aria-label="Media viewer">
  <div class="media-modal__panel">
    <button type="button" class="media-modal__close" data-media-close aria-label="Close">
      Close
    </button>
    <div class="media-modal__frame">
      <video class="media-modal__video" id="mediaModalVideo" controls playsinline></video>
      <iframe
        class="media-modal__embed"
        id="mediaModalEmbed"
        title="360 media"
        allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
        allowfullscreen
        loading="lazy"></iframe>
    </div>
  </div>
</dialog>

<style is:global>
  .media-modal {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: min(960px, calc(100vw - 32px));
    width: 100%;
  }

  .media-modal::backdrop {
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(8px);
  }

  .media-modal__panel {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    background: rgba(10, 10, 10, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
  }

  .media-modal__close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 8px 12px;
    cursor: pointer;
  }

  .media-modal__frame {
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .media-modal__video,
  .media-modal__embed {
    width: 100%;
    height: 100%;
    border: 0;
    display: none;
  }

  .media-modal[data-mode='video'] .media-modal__video {
    display: block;
  }

  .media-modal[data-mode='embed'] .media-modal__embed {
    display: block;
  }
</style>
