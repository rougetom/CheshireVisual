---
import VideoScene from './VideoScene.astro';

const logoCount = 8;
---

<VideoScene id="clients">
  <div class="head">
    <h2>Trusted across the North West.</h2>
    <p class="lede">
      From independent schools and colleges to housebuilders and event venues &mdash; teams across
      the North West bring us in when the footage has a job to do.
    </p>
  </div>

  <ul class="logo-grid">
    {
      Array.from({ length: logoCount }, (_, i) => (
        <li>
          <img
            src="/client-logo.svg"
            alt={i === 0 ? 'Client logo' : ''}
            width="220"
            height="48"
          />
        </li>
      ))
    }
  </ul>
</VideoScene>

<style>
  h2 {
    font-weight: 800;
    font-size: clamp(28px, 3.6vw, 44px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #fff;
    margin-bottom: 16px;
  }

  .lede {
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
    max-width: 560px;
  }

  .logo-grid {
    list-style: none;
    margin: 32px 0 0;
    padding: 28px 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px 40px;
    align-items: center;
  }

  .logo-grid img {
    display: block;
    width: min(100%, 220px);
    height: auto;
    margin-inline: auto;
    opacity: 0.88;
  }

  @media (max-width: 900px) {
    .logo-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px 28px;
    }
  }
</style>
