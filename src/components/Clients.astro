---
import VideoScene from './VideoScene.astro';

// Placeholder sector wordmarks — swap for real client logos once available.
// Deliberately generic (not fabricated company names) until you can supply
// approved logos/case studies.
const sectors = [
  'Independent Schools',
  'Housebuilders',
  'Construction Groups',
  'Sports Clubs',
  'Further Education',
  'Event Venues',
];
---

<VideoScene id="clients" video="https://vz-fa5f7bf1-41c.b-cdn.net/1222f359-d210-400e-afdc-7f0222e0d18b/playlist.m3u8">
  <div class="head">
    <p class="kicker">04 / Clients</p>
    <h2>Trusted across the North West.</h2>
    <p class="lede">
      From independent schools and colleges to housebuilders and event venues &mdash; teams across
      the North West bring us in when the footage has a job to do.
    </p>
  </div>

  <ul class="sector-strip">
    {sectors.map((sector) => <li>{sector}</li>)}
  </ul>
</VideoScene>

<style>
  .kicker {
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
    margin-bottom: 18px;
  }

  h2 {
    font-weight: 700;
    font-size: clamp(28px, 3.6vw, 44px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #fff;
    margin-bottom: 16px;
  }

  .lede {
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
    max-width: 560px;
  }

  .sector-strip {
    list-style: none;
    margin: 32px 0 0;
    padding: 22px 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
  }

  .sector-strip li {
    font-size: 12.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
    white-space: nowrap;
  }
</style>
