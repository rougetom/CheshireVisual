---
// A contained, framed video/image panel — the black-and-white redesign's
// replacement for the old full-bleed dark video backdrop. Footage is
// desaturated (grayscale filter) so real colour never re-enters the
// otherwise strictly black-and-white palette.
interface Props {
  src?: string;
  ratio?: string;
  anim?: 'kb' | 'kb2';
  label?: string;
}

const { src, ratio = '4 / 3', anim = 'kb', label } = Astro.props;
---

<div class="video-panel" style={`aspect-ratio:${ratio}`}>
  <div class={`grade ${anim}`}></div>
  {
    src && (
      <video class="footage" muted loop playsinline autoplay preload="metadata">
        <source src={src} type="video/mp4" />
      </video>
    )
  }
  {label && <span class="label">{label}</span>}
  <span class="corner corner-tl" aria-hidden="true"></span>
  <span class="corner corner-br" aria-hidden="true"></span>
</div>

<style>
  .video-panel {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-text);
    background: var(--color-bg-panel);
  }

  .grade {
    position: absolute;
    inset: -8%;
    background: linear-gradient(135deg, #e4e4e0, #f2f2f0 55%, #e9e9e5);
  }

  .grade.kb {
    animation: kb 34s ease-in-out infinite;
  }

  .grade.kb2 {
    animation: kb2 36s ease-in-out infinite;
  }

  .footage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }

  .label {
    position: absolute;
    left: 18px;
    bottom: 16px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text);
    background: #fff;
    padding: 5px 10px;
    border: 1px solid var(--color-text);
  }

  .corner {
    position: absolute;
    width: 14px;
    height: 14px;
    pointer-events: none;
  }

  .corner-tl {
    top: -1px;
    left: -1px;
    border-top: 2px solid var(--color-text);
    border-left: 2px solid var(--color-text);
  }

  .corner-br {
    bottom: -1px;
    right: -1px;
    border-bottom: 2px solid var(--color-text);
    border-right: 2px solid var(--color-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .grade {
      animation: none;
    }
  }
</style>
