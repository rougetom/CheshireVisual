---
interface Props {
  gradient: string;
  animation?: 'kb' | 'kb2';
  scrim?: string;
  grain?: boolean;
  videoSrc?: string;
  videoId?: string;
  poster?: string;
}

const {
  gradient,
  animation = 'kb',
  scrim = 'linear-gradient(180deg, transparent 46%, rgba(0,0,0,.82))',
  grain = true,
  videoSrc,
  videoId,
  poster,
} = Astro.props;
---

<div class="backdrop" aria-hidden="true">
  <div class={`grade ${animation}`} style={`background:${gradient}`}></div>
  {
    (videoSrc || videoId) && (
      <video
        id={videoId}
        class="footage"
        muted
        loop
        playsinline
        preload="metadata"
        poster={poster}
      >
        {videoSrc && <source src={videoSrc} type="video/mp4" />}
      </video>
    )
  }
  <div class="scrim" style={`background:${scrim}`}></div>
  {grain && <div class="grain-layer"></div>}
</div>

<style>
  .backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .grade {
    position: absolute;
    inset: -10%;
  }

  .grade.kb {
    animation: kb 32s ease-in-out infinite;
  }

  .grade.kb2 {
    animation: kb2 34s ease-in-out infinite;
  }

  .footage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scrim {
    position: absolute;
    inset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .footage {
      display: none;
    }
  }
</style>
