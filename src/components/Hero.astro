---
---

<section
  id="hero"
  class="hero-scene"
  data-shot
  data-grade="radial-gradient(120% 80% at 30% 18%, #262630, #14141a 48%, #0a0a0c 80%)"
  data-scrim="linear-gradient(180deg, transparent 46%, rgba(0,0,0,.82))"
  data-anim="kb"
  data-video="/videos/hero.mp4"
>
  <div class="hero-content">
    <p class="kicker" data-reveal data-reveal-trigger="load">Aerial · 360° · Film</p>
    <h1 data-reveal data-reveal-trigger="load">see it from<br />every angle<span class="accent">.</span></h1>
    <div class="hero-row" data-reveal data-reveal-trigger="load">
      <p class="lede">
        CAA-licensed drone, aerial and 360&deg; video production for property, construction, education
        and events across Cheshire and the North West of England.
      </p>
      <div class="scroll-cue" aria-hidden="true">
        <span>Scroll</span>
        <span class="arrow">↓</span>
      </div>
    </div>
    <p class="credibility" data-reveal data-reveal-trigger="load">
      Property · Construction · Events · Education&nbsp;&nbsp;
      <span class="dot">◆</span>&nbsp;&nbsp;CAA licensed · Fully insured · 4K &amp; 8K 360&deg;
    </p>
  </div>
</section>

<style>
  .hero-scene {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    padding: 140px var(--section-x) var(--section-x);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .hero-content > [data-reveal]:nth-child(1) {
    transition-delay: 0s;
  }

  .hero-content > [data-reveal]:nth-child(2) {
    transition-delay: 0.1s;
  }

  .hero-content > [data-reveal]:nth-child(3) {
    transition-delay: 0.2s;
  }

  .hero-content > [data-reveal]:nth-child(4) {
    transition-delay: 0.3s;
  }

  .kicker {
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-text-60);
    margin-bottom: 28px;
  }

  h1 {
    font-weight: 700;
    color: #fff;
    font-size: clamp(44px, 9vw, 128px);
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .accent {
    color: var(--color-accent);
  }

  .hero-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    margin-top: 36px;
    flex-wrap: wrap;
  }

  .lede {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text-72);
    max-width: 460px;
  }

  .scroll-cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--color-text-60);
    font-size: 10.5px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .scroll-cue .arrow {
    animation: cue 1.8s ease-in-out infinite;
    font-size: 15px;
  }

  .credibility {
    margin-top: 30px;
    padding-top: 22px;
    border-top: 1px solid var(--color-border-09);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-50);
  }

  .dot {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .credibility {
      line-height: 2;
    }
  }
</style>
