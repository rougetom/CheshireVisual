---
---

<section id="hero" class="hero-scene">
  <div class="hero-stage" id="heroStage">
    <video id="heroVideo" class="footage" muted loop playsinline autoplay preload="metadata">
      <source src="/videos/hero.mp4" type="video/mp4" />
    </video>
    <div class="scrim"></div>

    <div class="hero-content">
      <p class="kicker" data-reveal data-reveal-trigger="load">Aerial · 360° · Film</p>
      <h1 data-reveal data-reveal-trigger="load">See it from<br />every angle.</h1>
      <div class="hero-row" data-reveal data-reveal-trigger="load">
        <p class="lede">
          CAA-licensed drone, aerial and 360&deg; video production for property, construction, education
          and events across Cheshire and the North West of England.
        </p>
        <div class="scroll-cue" aria-hidden="true">
          <span>Scroll</span>
          <span class="arrow">↓</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-scene {
    position: relative;
    height: 220vh;
  }

  .hero-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    background: var(--color-text);
  }

  .footage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.15) 42%, rgba(0, 0, 0, 0.1) 65%, rgba(0, 0, 0, 0.4) 100%);
  }

  .hero-content {
    position: absolute;
    left: var(--section-x);
    right: var(--section-x);
    bottom: 64px;
    z-index: 1;
    color: #fff;
  }

  .hero-content > [data-reveal]:nth-child(1) {
    transition-delay: 0s;
  }

  .hero-content > [data-reveal]:nth-child(2) {
    transition-delay: 0.1s;
  }

  .hero-content > [data-reveal]:nth-child(3) {
    transition-delay: 0.2s;
  }

  .kicker {
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
    margin-bottom: 24px;
  }

  h1 {
    font-weight: 700;
    color: #fff;
    font-size: clamp(52px, 10vw, 148px);
    line-height: 0.88;
    letter-spacing: -0.04em;
  }

  .hero-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  .lede {
    font-size: 16px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
    max-width: 460px;
  }

  .scroll-cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 10.5px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .scroll-cue .arrow {
    animation: cue 1.8s ease-in-out infinite;
    font-size: 15px;
  }
</style>

<script>
  const scene = document.getElementById('hero');
  const video = document.getElementById('heroVideo') as HTMLVideoElement | null;
  const scroller = document.getElementById('siteScroll');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (scene && video && scroller && !reduceMotion) {
    let ticking = false;

    const update = () => {
      ticking = false;
      const rect = scene.getBoundingClientRect();
      const total = scene.offsetHeight - scroller.clientHeight;
      const p = Math.min(1, Math.max(0, -rect.top / Math.max(total, 1)));

      if (video.readyState >= 1 && video.duration) {
        video.currentTime = p * video.duration;
      }
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    scroller.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>
