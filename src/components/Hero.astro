---
import VideoScene from './VideoScene.astro';
---

<VideoScene id="hero" video="https://vz-fa5f7bf1-41c.b-cdn.net/1222f359-d210-400e-afdc-7f0222e0d18b/playlist.m3u8">
  <p class="kicker">Aerial · 360° · Film</p>
  <h1>See it from<br />every angle.</h1>
  <div class="hero-row">
    <p class="lede">
      CAA-licensed drone, aerial and 360&deg; video production for property, construction, education
      and events across Cheshire and the North West of England.
    </p>
    <div class="scroll-cue" aria-hidden="true">
      <span>Scroll</span>
      <span class="arrow">↓</span>
    </div>
  </div>
</VideoScene>

<style>
  .kicker {
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
    margin-bottom: 24px;
  }

  h1 {
    font-weight: 700;
    color: #fff;
    font-size: clamp(52px, 10vw, 148px);
    line-height: 0.88;
    letter-spacing: -0.04em;
  }

  .hero-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  .lede {
    font-size: 16px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
    max-width: 460px;
  }

  .scroll-cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 10.5px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .scroll-cue .arrow {
    animation: cue 1.8s ease-in-out infinite;
    font-size: 15px;
  }
</style>
