---
import GlassCard from 'astro-liquid-glass/components/GlassCard.astro';
import VideoScene from './VideoScene.astro';

const services = [
  {
    title: 'Aerial film & photography',
    body: 'Cinematic drone cinematography and stills in up to 8K, graded to match your brand.',
  },
  {
    title: '360° & virtual tours',
    body: 'Immersive 360° capture and walkthroughs, embeddable directly on your website.',
  },
  {
    title: 'Post Production',
    body: 'We edit, colour grade and publish your footage.',
  },
];
---

<VideoScene id="services">
  <h2>Services</h2>

  <div class="grid">
    {
      services.map((service) => (
        <GlassCard class="service-card">
          <h3>{service.title}</h3>
          <p>{service.body}</p>
        </GlassCard>
      ))
    }
  </div>
</VideoScene>

<style>
  h2 {
    font-weight: 800;
    font-size: clamp(30px, 3.6vw, 48px);
    letter-spacing: -0.03em;
    color: #fff;
    margin-bottom: 28px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 36px;
  }

  .service-card {
    --glass-bg: rgba(255, 255, 255, 0.2);
    --glass-border: rgba(255, 255, 255, 0.35);
    --glass-blur: 18px;
    --glass-saturate: 155%;
    border-radius: 22px;
    padding: 28px;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  h3 {
    font-weight: 700;
    font-size: clamp(19px, 1.8vw, 24px);
    letter-spacing: -0.02em;
    color: #fff;
    margin-bottom: 10px;
  }

  .service-card p {
    font-size: 14px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.72);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
