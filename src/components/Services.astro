---
const services = [
  {
    index: '(01)',
    title: 'Aerial film & photography',
    body: 'Cinematic drone cinematography and stills in up to 8K — sweeping reveals, orbits and top-downs, graded to match your brand. Ideal for property marketing, construction progress and event coverage.',
  },
  {
    index: '(02)',
    title: '360° & virtual tours',
    body: 'Immersive 360° capture and interactive walkthroughs for property, education and venues — every corner, on demand, embeddable directly on your website.',
  },
  {
    index: '(03)',
    title: 'Ground filming & post-production',
    body: 'Full production on the ground and in the edit — motion graphics, colour grading and sound design, delivered ready to publish across web, social and print.',
  },
];
---

<section id="services" class="services">
  <div class="inner">
    <p class="kicker" data-reveal>02 / Services</p>
    <h2 class="visually-hidden">Drone, aerial and 360° video services</h2>

    <div class="grid">
      {
        services.map((service) => (
          <div class="col" data-reveal>
            <div class="index">{service.index}</div>
            <h3>{service.title}</h3>
            <p>{service.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    position: relative;
    padding: 120px var(--section-x);
  }

  .inner {
    position: relative;
    z-index: 1;
  }

  .grid .col:nth-child(1) {
    transition-delay: 0s;
  }

  .grid .col:nth-child(2) {
    transition-delay: 0.1s;
  }

  .grid .col:nth-child(3) {
    transition-delay: 0.2s;
  }

  .kicker {
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-text-55);
    margin-bottom: 56px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--color-border-12);
  }

  .col {
    padding: 44px 40px 44px 0;
    border-right: 1px solid var(--color-border-12);
  }

  .col:last-child {
    border-right: none;
    padding-right: 0;
  }

  .col:not(:first-child) {
    padding-left: 40px;
  }

  .index {
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--color-text-40);
    margin-bottom: 26px;
  }

  h3 {
    font-weight: 700;
    font-size: 30px;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }

  .col p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-68);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      border-top: none;
    }

    .col {
      border-right: none;
      border-top: 1px solid var(--color-border-12);
      padding: 32px 0 !important;
    }
  }
</style>
