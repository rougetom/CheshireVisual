---
import VideoScene from './VideoScene.astro';

const services = [
  {
    title: 'Aerial film & photography',
    body: 'Cinematic drone cinematography and stills in up to 8K, graded to match your brand.',
  },
  {
    title: '360° & virtual tours',
    body: 'Immersive 360° capture and walkthroughs, embeddable directly on your website.',
  },
  {
    title: 'Post Production',
    body: 'We edit, colour grade and publish your footage.',
  },
];
---

<VideoScene id="services">
  <h2>Services</h2>

  <div class="grid">
    {
      services.map((service) => (
        <div class="col">
          <h3>{service.title}</h3>
          <p>{service.body}</p>
        </div>
      ))
    }
  </div>
</VideoScene>

<style>
  h2 {
    font-weight: 800;
    font-size: clamp(30px, 3.6vw, 48px);
    letter-spacing: -0.03em;
    color: #fff;
    margin-bottom: 28px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
  }

  .col {
    padding: 28px 40px 0 0;
    border-right: 1px solid rgba(255, 255, 255, 0.25);
  }

  .col:last-child {
    border-right: none;
    padding-right: 0;
  }

  .col:not(:first-child) {
    padding-left: 40px;
  }

  h3 {
    font-weight: 700;
    font-size: clamp(19px, 1.8vw, 24px);
    letter-spacing: -0.02em;
    color: #fff;
    margin-bottom: 10px;
  }

  .col p {
    font-size: 14px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.72);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      border-top: none;
      gap: 18px;
    }

    .col {
      border-right: none;
      padding: 0 !important;
    }
  }
</style>
