---
import { clips, sceneIds, type SceneId } from '@/lib/bunny';

const firstId = sceneIds[0];
---

<div class="site-bg" aria-hidden="true">
  {
    sceneIds.map((id: SceneId, i) => {
      const clip = clips[id];
      const eager = id === firstId;
      return (
        <video
          data-scene-video={id}
          class:list={['footage', eager && 'footage--hero']}
          muted
          loop
          playsinline
          preload={eager ? 'auto' : 'metadata'}
          poster={clip.poster}
          disablepictureinpicture
          style={`z-index:${i}`}
        >
          <source src={clip.p1080} type="video/mp4" media="(min-width: 900px)" />
          <source src={clip.p720} type="video/mp4" />
        </video>
      );
    })
  }
  <div class="scrim"></div>
</div>

<style>
  .site-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: #000;
    pointer-events: none;
  }

  .footage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    opacity: 0;
  }

  .footage:first-of-type {
    opacity: 1;
  }

  /* Local LQIP fill so the frame isn't black while the hero MP4 arrives. */
  .footage--hero {
    background: url('/hero-lqip.jpg') center / cover no-repeat;
  }

  .scrim {
    position: absolute;
    inset: 0;
    z-index: 20;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.6) 0%,
      rgba(0, 0, 0, 0.08) 32%,
      rgba(0, 0, 0, 0.05) 60%,
      rgba(0, 0, 0, 0.72) 100%
    );
  }
</style>
