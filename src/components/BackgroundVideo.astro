---
// A single fixed, full-viewport video backdrop shared by every section (see
// src/scripts/backdrop.ts) — replaces the old per-section SectionBackdrop.
// Each <section data-shot> declares its own grade/scrim/video via data
// attributes; the script crossfades between them as you scroll. The first
// section's shot is rendered here too, server-side, so the hero has a
// working backdrop with zero JS.
interface Props {
  grade: string;
  scrim: string;
  anim?: 'kb' | 'kb2';
  video: string;
}

const { grade, scrim, anim = 'kb', video } = Astro.props;
---

<div id="bgVideo" class="bg-video" aria-hidden="true">
  <div class={`grade is-active ${anim}`} style={`background:${grade}`}></div>
  <div class="grade"></div>
  <video class="footage" muted loop playsinline autoplay preload="auto">
    <source src={video} type="video/mp4" />
  </video>
  <div class="scrim is-active" style={`background:${scrim}`}></div>
  <div class="scrim"></div>
  <div class="grain-layer"></div>
</div>

<style>
  .bg-video {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--color-bg-media);
  }

  .grade {
    position: absolute;
    inset: -10%;
    opacity: 0;
    transition: opacity 1.1s var(--ease-reveal);
  }

  .grade.is-active {
    opacity: 1;
  }

  .grade.kb {
    animation: kb 32s ease-in-out infinite;
  }

  .grade.kb2 {
    animation: kb2 34s ease-in-out infinite;
  }

  .footage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scrim {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.1s var(--ease-reveal);
  }

  .scrim.is-active {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .footage {
      display: none;
    }

    .grade,
    .scrim {
      transition: none;
    }
  }
</style>

<script>
  import '@/scripts/backdrop';
</script>
