---
import VideoScene from './VideoScene.astro';
---

<VideoScene id="contact">
  <div class="row">
    <h2>Let's get<br />you noticed.</h2>

    <div class="links">
      <a href="mailto:hello@cheshirevisual.co.uk" class="link-row">
        hello@cheshirevisual.co.uk <span class="arrow">→</span>
      </a>
      <a href="tel:+441000000000" class="link-row">
        +44 (0)1000 000 000 <span class="arrow">→</span>
      </a>
      <p class="note">
        Based in Cheshire. Flying across Chester, Manchester, Liverpool, Warrington and the wider
        North West.
      </p>
    </div>
  </div>
</VideoScene>

<style>
  .row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 60px;
    flex-wrap: wrap;
  }

  h2 {
    font-weight: 800;
    color: #fff;
    font-size: clamp(38px, 6vw, 92px);
    line-height: 0.92;
    letter-spacing: -0.04em;
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 300px;
  }

  .link-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    padding-bottom: 14px;
    font-size: 17px;
    color: #fff;
    transition: border-color 0.2s ease;
  }

  .link-row:hover,
  .link-row:focus-visible {
    border-color: #fff;
  }

  .arrow {
    color: #fff;
  }

  .note {
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.6;
  }
</style>
