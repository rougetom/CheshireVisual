---
// Overlay section sitting on the fixed background video. The page never
// pans: each scene is a tall wrapper with a sticky 100vh stage, so copy
// stays pinned while scroll scrubs the (single, full-bleed) video behind
// it. scene.ts fades copy and the matching clip with how much of the
// frame this stage covers, so adjacent scenes hand off instead of sitting
// on black for a full viewport. The video itself never moves or scales.
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<section id={id} class="scene" data-scene>
  <div class="stage">
    <div class="stage-inner">
      <div class="content">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .scene {
    position: relative;
    height: 200vh;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
  }

  .stage-inner {
    position: absolute;
    inset: 0;
    will-change: opacity;
  }

  .content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 96px var(--section-x) 72px;
    color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .stage-inner {
      opacity: 1 !important;
    }
  }
</style>
