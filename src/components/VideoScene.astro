---
// Shared full-bleed video "scene" — every top-level section (and the
// footer) is one of these steps. Base CSS here is the progressive-
// enhancement fallback: steps stacked in normal document flow, each one
// viewport tall, videos just autoplaying — works with no JS and under
// prefers-reduced-motion. The paginated, video-gated, fade/scale/delay
// behaviour (driven by src/scripts/scene.ts) is layered on top via
// #siteScroll[data-paginate="true"] rules in global.css, since that
// state lives on an ancestor outside this component.
interface Props {
  id: string;
  video: string;
  scrim?: string;
}

const {
  id,
  video,
  scrim = 'linear-gradient(180deg, rgba(0,0,0,.6) 0%, rgba(0,0,0,.08) 32%, rgba(0,0,0,.05) 60%, rgba(0,0,0,.72) 100%)',
} = Astro.props;
---

<section id={id} class="scene" data-scene>
  <div class="stage">
    <div class="stage-inner">
      <video class="footage" muted playsinline autoplay preload="auto">
        <source src={video} type="video/mp4" />
      </video>
      <div class="scrim" style={`background:${scrim}`}></div>
      <div class="content">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .scene {
    position: relative;
    height: 100vh;
  }

  .stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #000;
  }

  .stage-inner {
    position: absolute;
    inset: 0;
    transform-origin: 50% 50%;
  }

  .footage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 96px var(--section-x) 72px;
    color: #fff;
  }
</style>
