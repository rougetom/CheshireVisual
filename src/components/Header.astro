---
const navLinks = [
  { href: '#about', label: 'About' },
  { href: '#services', label: 'Services' },
  { href: '#use-cases', label: 'Use cases' },
  { href: '#clients', label: 'Clients' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="bar">
    <a class="wordmark" href="#hero">Cheshire Visual</a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
      <span class="visually-hidden">Toggle menu</span>
      <span class="menu-toggle__bars" aria-hidden="true"></span>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label="Primary">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
      <a class="cta" href="#contact">Get a quote</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    padding: 18px var(--section-x);
    background: transparent;
    border-bottom: 1px solid transparent;
    color: #fff;
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease;
  }

  .site-header[data-solid='true'] {
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-border-09);
    color: var(--color-text);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .wordmark {
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .primary-nav {
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .primary-nav ul {
    display: flex;
    gap: 40px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .primary-nav a {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: inherit;
    opacity: 0.75;
    transition: opacity 0.2s ease;
  }

  .primary-nav a:hover,
  .primary-nav a:focus-visible {
    opacity: 1;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border: 1px solid currentColor;
    color: inherit !important;
    border-radius: 999px;
    white-space: nowrap;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .site-header:not([data-solid='true']) .cta:hover,
  .site-header:not([data-solid='true']) .cta:focus-visible {
    background: #fff;
    color: var(--color-text) !important;
    transform: translateY(-1px);
  }

  .site-header[data-solid='true'] .cta:hover,
  .site-header[data-solid='true'] .cta:focus-visible {
    background: var(--color-text);
    color: var(--color-bg) !important;
    transform: translateY(-1px);
  }

  .menu-toggle {
    display: none;
    width: 40px;
    height: 40px;
    border: 1px solid currentColor;
    opacity: 0.6;
    background: transparent;
    border-radius: 50%;
    position: relative;
    cursor: pointer;
  }

  .menu-toggle__bars,
  .menu-toggle__bars::before,
  .menu-toggle__bars::after {
    content: '';
    position: absolute;
    left: 11px;
    right: 11px;
    height: 1px;
    background: currentColor;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .menu-toggle__bars {
    top: 19px;
  }

  .menu-toggle__bars::before {
    top: -6px;
  }

  .menu-toggle__bars::after {
    top: 6px;
  }

  .site-header[data-open='true'] .menu-toggle__bars {
    background: transparent;
  }

  .site-header[data-open='true'] .menu-toggle__bars::before {
    transform: translateY(6px) rotate(45deg);
  }

  .site-header[data-open='true'] .menu-toggle__bars::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 900px) {
    .menu-toggle {
      display: block;
    }

    .primary-nav {
      position: fixed;
      inset: 0;
      top: 0;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      gap: 36px;
      padding: 0 var(--section-x-mobile);
      background: #fffffffa;
      color: var(--color-text);
      transform: translateY(-100%);
      opacity: 0;
      transition:
        transform 0.35s var(--ease-reveal),
        opacity 0.35s var(--ease-reveal);
      pointer-events: none;
    }

    .site-header[data-open='true'] .primary-nav {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }

    .primary-nav ul {
      flex-direction: column;
      gap: 22px;
    }

    .primary-nav a {
      font-size: 20px;
    }

    .cta {
      font-size: 13px;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = header?.querySelector<HTMLElement>('.primary-nav');
  const scroller = document.getElementById('siteScroll');

  toggle?.addEventListener('click', () => {
    const isOpen = header?.getAttribute('data-open') === 'true';
    header?.setAttribute('data-open', String(!isOpen));
    toggle.setAttribute('aria-expanded', String(!isOpen));
    if (scroller) scroller.style.overflowY = isOpen ? '' : 'hidden';
  });

  nav?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      header?.setAttribute('data-open', 'false');
      toggle?.setAttribute('aria-expanded', 'false');
      if (scroller) scroller.style.overflowY = '';
    });
  });

  // The header floats transparent (white text) over the hero's video and
  // flips to a solid, blurred white bar (dark text) once the hero has
  // scrolled fully out of view — it stays transparent for the hero's whole
  // pinned/scrubbing duration, not just its first screenful.
  const hero = document.getElementById('hero');
  if (header && hero && scroller) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          header.setAttribute('data-solid', String(!entry.isIntersecting));
        });
      },
      { root: scroller, threshold: 0 }
    );
    io.observe(hero);
  }
</script>
