---
const tiles = [
  {
    name: 'Schools',
    tag: 'Aerial',
    anim: 'kb',
    pos: '30% 20%',
    stops: '#2a2a34, #131318 52%, #0c0c0e 82%',
    desc: 'Prospectus films & open-day aerial tours',
  },
  {
    name: 'Sports clubs',
    tag: 'Film',
    anim: 'kb2',
    pos: '70% 30%',
    stops: '#2b2b33, #141419 52%, #0c0c0e 82%',
    desc: 'Matchday highlights & facility showcases',
  },
  {
    name: 'Construction',
    tag: '4K',
    anim: 'kb',
    pos: '50% 80%',
    stops: '#2c2b32, #141318 50%, #0b0b0d 82%',
    desc: 'Progress surveys & site documentation',
  },
  {
    name: 'Colleges',
    tag: '360°',
    anim: 'kb2',
    pos: '24% 40%',
    stops: '#29292f, #131317 52%, #0c0c0e 82%',
    desc: 'Campus 360° tours & recruitment content',
  },
  {
    name: 'Venues',
    tag: '360°',
    anim: 'kb',
    pos: '76% 22%',
    stops: '#2a2a33, #131318 50%, #0b0b0d 82%',
    desc: 'Event spaces from every angle',
  },
  {
    name: 'Property',
    tag: 'Film',
    anim: 'kb2',
    pos: '46% 62%',
    stops: '#2c2b34, #141419 52%, #0c0c0e 82%',
    desc: 'Listings & developments, cinematic and 360°',
  },
];
---

<section
  id="use-cases"
  class="use-cases"
  data-shot
  data-grade="radial-gradient(130% 90% at 50% 0%, #1c1c22, #0e0e11 55%, #0a0a0c 85%)"
  data-scrim="linear-gradient(180deg, rgba(10,10,11,.85), rgba(10,10,11,.6) 30%, rgba(10,10,11,.94))"
  data-anim="kb"
  data-video="/videos/hero.mp4"
>
  <div class="inner">
    <div class="head">
      <div data-reveal>
        <p class="kicker">03 / Who we fly for</p>
        <h2>Made for<br />every brief.</h2>
      </div>
      <a data-reveal href="#contact" class="brief-link">Discuss your brief →</a>
    </div>

    <div class="grid">
      {
        tiles.map((tile) => (
          <div class="tile" data-reveal>
            <div
              class={`grade ${tile.anim}`}
              style={`background: radial-gradient(120% 90% at ${tile.pos}, ${tile.stops})`}
            />
            <div class="grain-layer" style="opacity:.08" />
            <div class="scrim" />
            <span class="play" aria-hidden="true">▶</span>
            <span class="tag">{tile.tag}</span>
            <div class="label">
              <h3>{tile.name}</h3>
              <p>{tile.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .use-cases {
    position: relative;
    padding: 130px var(--section-x) 120px;
  }

  .inner {
    position: relative;
    z-index: 1;
  }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 56px;
    gap: 24px;
    flex-wrap: wrap;
  }

  .head [data-reveal]:nth-child(2) {
    transition-delay: 0.1s;
  }

  .grid .tile:nth-child(1) {
    transition-delay: 0s;
  }

  .grid .tile:nth-child(2) {
    transition-delay: 0.08s;
  }

  .grid .tile:nth-child(3) {
    transition-delay: 0.16s;
  }

  .grid .tile:nth-child(4) {
    transition-delay: 0.24s;
  }

  .grid .tile:nth-child(5) {
    transition-delay: 0.32s;
  }

  .grid .tile:nth-child(6) {
    transition-delay: 0.4s;
  }

  .kicker {
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 18px;
  }

  h2 {
    font-weight: 700;
    font-size: clamp(36px, 5vw, 68px);
    line-height: 0.96;
    letter-spacing: -0.035em;
  }

  .brief-link {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-70);
    border-bottom: 1px solid var(--color-border-25);
    padding-bottom: 6px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .tile {
    position: relative;
    overflow: hidden;
    background: var(--color-bg-tile);
    aspect-ratio: 4 / 3;
    cursor: pointer;
    transition: box-shadow 0.25s ease;
  }

  .tile:hover,
  .tile:focus-within {
    box-shadow: inset 0 0 0 1px var(--color-accent-ring);
  }

  .grade {
    position: absolute;
    inset: -10%;
  }

  .grade.kb {
    animation: kb 30s ease-in-out infinite;
  }

  .grade.kb2 {
    animation: kb2 34s ease-in-out infinite;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 46%, rgba(0, 0, 0, 0.82));
  }

  .play {
    position: absolute;
    top: 18px;
    left: 18px;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--color-border-40);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.75);
  }

  .tag {
    position: absolute;
    top: 22px;
    right: 20px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-50);
  }

  .label {
    position: absolute;
    left: 22px;
    bottom: 20px;
    right: 22px;
  }

  .label h3 {
    font-weight: 600;
    font-size: 21px;
    letter-spacing: -0.015em;
  }

  .label p {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--color-text-60);
    margin-top: 7px;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
