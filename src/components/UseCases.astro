---
import LiquidGlass from './LiquidGlass.astro';
import VideoScene from './VideoScene.astro';
import { clips, bunnyPreview } from '@/lib/bunny';

const tiles = [
  {
    name: 'Schools',
    tag: 'Aerial',
    desc: 'Prospectus films & open-day aerial tours',
    clip: clips.hero,
  },
  {
    name: 'Sports clubs',
    tag: 'Film',
    desc: 'Matchday highlights & facility showcases',
    clip: clips.about,
  },
  {
    name: 'Construction',
    tag: '4K',
    desc: 'Progress surveys & site documentation',
    clip: clips.services,
  },
  {
    name: 'Colleges',
    tag: '360°',
    desc: 'Campus 360° tours & recruitment content',
    clip: clips['use-cases'],
  },
  {
    name: 'Venues',
    tag: '360°',
    desc: 'Event spaces from every angle',
    clip: clips.clients,
  },
  {
    name: 'Property',
    tag: 'Film',
    desc: 'Listings & developments, cinematic and 360°',
    clip: clips.contact,
  },
];
---

<VideoScene id="use-cases">
  <div class="head">
    <div>
      <h2>Made for every brief.</h2>
    </div>
    <a href="#contact" class="brief-link">Discuss your brief →</a>
  </div>

  <div class="grid">
    {
      tiles.map((tile) => (
        <LiquidGlass
          as="button"
          type="button"
          interactive
          class="tile"
          data-media-open
          data-media-mode="video"
          data-video-src={tile.clip.p1080}
          data-video-poster={tile.clip.poster}
          aria-label={`Play ${tile.name} example`}
        >
          <div class="thumb">
            <img
              src={bunnyPreview(tile.clip.id)}
              data-fallback={tile.clip.poster}
              alt=""
              width="640"
              height="360"
              loading="lazy"
              decoding="async"
            />
            <span class="tag">{tile.tag}</span>
          </div>
          <h3>{tile.name}</h3>
          <p>{tile.desc}</p>
        </LiquidGlass>
      ))
    }
  </div>
</VideoScene>

<style>
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 28px;
    gap: 24px;
    flex-wrap: wrap;
  }

  h2 {
    font-weight: 800;
    font-size: clamp(28px, 3.6vw, 44px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: #fff;
  }

  .brief-link {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    padding-bottom: 6px;
    white-space: nowrap;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 36px;
  }

  .tile {
    padding: 14px;
  }

  .thumb {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    margin-bottom: 14px;
    background: rgba(0, 0, 0, 0.25);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tag {
    position: absolute;
    top: 10px;
    right: 10px;
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    padding: 5px 9px;
    backdrop-filter: blur(8px);
  }

  .tile h3 {
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.01em;
    color: #1a1a1a;
    margin: 0 0 6px;
  }

  .tile p {
    font-size: 12px;
    line-height: 1.45;
    color: #1a1a1a;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
