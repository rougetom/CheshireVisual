---
import LiquidGlass from './LiquidGlass.astro';
import VideoScene from './VideoScene.astro';
---

<VideoScene id="about">
  <div class="inner">
    <div class="heading">
      <h2>Drone &amp; 360&deg; video,<br />done to a standard.</h2>
    </div>

    <div class="copy">
      <LiquidGlass class="about-copy">
        <p>
          CAA-licensed drone, aerial and 360&deg; photography and video production, filming across
          Cheshire and the North West &mdash; Chester, Manchester, Liverpool, Warrington and beyond.
          Every flight is planned and insured; every edit delivered ready to publish.
        </p>
      </LiquidGlass>

      <ul class="stats">
        <li>
          <LiquidGlass class="stat-card">
            <span>CAA</span>
            Licensed remote pilot
          </LiquidGlass>
        </li>
        <li>
          <LiquidGlass class="stat-card">
            <span>4K&nbsp;/&nbsp;8K</span>
            Aerial &amp; 360&deg; capture
          </LiquidGlass>
        </li>
        <li>
          <LiquidGlass class="stat-card">
            <span>North West</span>
            Cheshire-based, flying region-wide
          </LiquidGlass>
        </li>
      </ul>
    </div>
  </div>
</VideoScene>

<style>
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 64px;
  }

  h2 {
    font-weight: 800;
    font-size: clamp(30px, 3.6vw, 48px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #fff;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .about-copy {
    padding: 22px 24px;
  }

  .about-copy p {
    font-size: 15px;
    line-height: 1.7;
    color: #1a1a1a;
    max-width: 560px;
  }

  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .stats li {
    min-width: 0;
  }

  .stat-card {
    padding: 18px 18px 16px;
    min-height: 100%;
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1a1a1a;
  }

  .stat-card :global(.liquid-glass__content) {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
  }

  .stat-card span {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 0;
    text-transform: none;
    color: #1a1a1a;
  }

  @media (max-width: 900px) {
    .inner {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .stats {
      grid-template-columns: 1fr;
    }
  }
</style>
