<canvas id="drone-canvas" class="drone-canvas" aria-hidden="true"></canvas>

<style>
  .drone-canvas {
    position: fixed;
    inset: 0;
    z-index: 6;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  // The drone overlay is a decorative enhancement layered over each section's
  // backdrop — load it after the initial page render (and skip it entirely on
  // data-saver connections) so it never competes with LCP-critical resources.
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection
    ?.saveData;

  if (!saveData) {
    const start = () => import('@/scripts/drone').then((m) => m.initDroneOverlay());
    const ric = (window as typeof window & { requestIdleCallback?: (cb: () => void) => void })
      .requestIdleCallback;

    if (ric) {
      ric(start);
    } else {
      window.addEventListener('load', start, { once: true });
    }
  }
</script>
